<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Vehicle Tracker</title>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet"/>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Roboto', sans-serif;
    background: #f1f3f4;
    color: #202124;
  }

  /* HEADER */
  header {
    background: #fff;
    border-bottom: 1px solid #dadce0;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header-title {
    font-size: 17px;
    font-weight: 500;
  }
  .header-title span { color: #1a73e8; }
  .header-right { font-size: 13px; color: #5f6368; font-family: monospace; }

  /* ALERT BAR */
  .alert-bar {
    background: #fce8e6;
    border-bottom: 2px solid #d93025;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }
  .alert-bar strong { color: #d93025; }
  .alert-bar .time-ago { margin-left: auto; color: #5f6368; font-size: 12px; }

  /* LAYOUT */
  .layout {
    display: flex;
    height: calc(100vh - 96px);
  }

  /* SIDEBAR */
  .sidebar {
    width: 290px;
    background: #fff;
    border-right: 1px solid #dadce0;
    overflow-y: auto;
    flex-shrink: 0;
  }

  .card {
    padding: 14px 16px;
    border-bottom: 1px solid #f1f3f4;
  }
  .card-title {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: #5f6368;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .coord-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .coord-label { font-size: 11px; color: #5f6368; margin-bottom: 2px; }
  .coord-value { font-size: 17px; font-weight: 500; color: #1a73e8; font-family: monospace; }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 0;
    border-bottom: 1px solid #f1f3f4;
    font-size: 13px;
  }
  .info-row:last-child { border-bottom: none; }
  .info-key { color: #5f6368; }
  .info-val { font-weight: 500; }
  .info-val.red   { color: #d93025; }
  .info-val.green { color: #188038; }
  .info-val.blue  { color: #1a73e8; }
  .info-val.orange{ color: #e37400; }

  .dot {
    display: inline-block;
    width: 7px; height: 7px;
    border-radius: 50%;
    margin-right: 5px;
    vertical-align: middle;
  }
  .dot.green  { background: #188038; }
  .dot.red    { background: #d93025; animation: blink 1.2s infinite; }
  .dot.orange { background: #e37400; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }

  .log-item {
    padding: 7px 0;
    border-bottom: 1px solid #f1f3f4;
    font-size: 12px;
  }
  .log-item:last-child { border-bottom: none; }
  .log-time { color: #5f6368; font-family: monospace; font-size: 11px; }
  .log-msg  { color: #202124; margin-top: 1px; }

  /* MAP */
  .map-area {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .map-bg {
    position: absolute;
    inset: 0;
    background: #e8f0e9;
    background-image:
      repeating-linear-gradient(0deg,   transparent, transparent 79px, rgba(255,255,255,.9) 79px, rgba(255,255,255,.9) 85px),
      repeating-linear-gradient(90deg,  transparent, transparent 79px, rgba(255,255,255,.9) 79px, rgba(255,255,255,.9) 85px),
      repeating-linear-gradient(0deg,   transparent, transparent 29px, rgba(255,255,255,.4) 29px, rgba(255,255,255,.4) 31px),
      repeating-linear-gradient(90deg,  transparent, transparent 29px, rgba(255,255,255,.4) 29px, rgba(255,255,255,.4) 31px);
  }

  .blk {
    position: absolute;
    background: #d5dbd6;
    border-radius: 2px;
  }
  .rd { position: absolute; background: #fff; }
  .rd.h  { height: 6px; }
  .rd.v  { width:  6px; }
  .rd.hb { height: 13px; }
  .rd.vb { width:  13px; }

  /* Pin marker */
  .marker {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -100%);
    z-index: 10;
    text-align: center;
  }
  .pin-body {
    width: 32px; height: 32px;
    background: #d93025;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    margin: 0 auto;
    box-shadow: 0 2px 8px rgba(0,0,0,.3);
    display: flex; align-items: center; justify-content: center;
  }
  .pin-icon {
    transform: rotate(45deg);
    font-size: 15px;
    margin-top: 2px;
  }
  .pin-label {
    margin-top: 6px;
    background: #fff;
    border: 1px solid #dadce0;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 500;
    box-shadow: 0 1px 4px rgba(0,0,0,.15);
    white-space: nowrap;
  }

  .acc-ring {
    position: absolute;
    top: 50%; left: 50%;
    width: 80px; height: 80px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(217,48,37,.07);
    border: 1.5px solid rgba(217,48,37,.3);
    z-index: 5;
  }

  .map-info-box {
    position: absolute;
    background: #fff;
    border: 1px solid #dadce0;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,.15);
    z-index: 20;
  }
  .map-info-box .lbl { font-size: 10px; color: #5f6368; margin-bottom: 2px; }
  .map-info-box .val { font-weight: 500; font-family: monospace; }

  .zoom {
    position: absolute;
    right: 14px; bottom: 70px;
    z-index: 20;
    background: #fff;
    border: 1px solid #dadce0;
    border-radius: 4px;
    box-shadow: 0 1px 4px rgba(0,0,0,.15);
    overflow: hidden;
  }
  .zoom-btn {
    display: block;
    width: 30px; height: 30px;
    text-align: center; line-height: 30px;
    font-size: 20px;
    cursor: pointer;
    color: #5f6368;
    user-select: none;
  }
  .zoom-btn:hover { background: #f1f3f4; }
  .zoom-divider { height: 1px; background: #dadce0; }

  .scale {
    position: absolute;
    bottom: 14px; left: 14px;
    z-index: 20;
  }
  .scale-line {
    width: 70px; height: 3px;
    background: #5f6368;
    border-left: 2px solid #5f6368;
    border-right: 2px solid #5f6368;
  }
  .scale-text { font-size: 10px; color: #5f6368; margin-top: 2px; }

  .updated-box {
    position: absolute;
    bottom: 14px; right: 50px;
    z-index: 20;
    background: #fff;
    border: 1px solid #dadce0;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    color: #5f6368;
    box-shadow: 0 1px 3px rgba(0,0,0,.1);
  }

  .attribution {
    position: absolute;
    bottom: 4px; right: 10px;
    font-size: 10px; color: #9aa0a6;
    z-index: 20;
  }
</style>
</head>
<body>

<header>
  <div class="header-title">Vehicle<span>Tracker</span></div>
  <div class="header-right" id="clock">--:--:--</div>
</header>

<div class="alert-bar">
  <span>⚠️</span>
  <div><strong>Accident Detected</strong> — Emergency SMS sent to registered contacts.</div>
  <div class="time-ago" id="time-ago">Calculating...</div>
</div>

<div class="layout">

  <!-- SIDEBAR -->
  <div class="sidebar">

    <div class="card">
      <div class="card-title">GPS Location</div>
      <div class="coord-row">
        <div>
          <div class="coord-label">Latitude</div>
          <div class="coord-value" id="lat">17.3900°N</div>
        </div>
        <div style="text-align:right">
          <div class="coord-label">Longitude</div>
          <div class="coord-value" id="lon">78.3200°E</div>
        </div>
      </div>
      <div class="info-row">
        <span class="info-key">Accuracy</span>
        <span class="info-val blue" id="acc">±5.1 m</span>
      </div>
      <div class="info-row">
        <span class="info-key">Satellites</span>
        <span class="info-val" id="sats">9 connected</span>
      </div>
      <div class="info-row">
        <span class="info-key">GPS Status</span>
        <span class="info-val green"><span class="dot green"></span>Fixed</span>
      </div>
    </div>

    <div class="card">
      <div class="card-title">Vehicle Status</div>
      <div class="info-row">
        <span class="info-key">Alert Status</span>
        <span class="info-val red"><span class="dot red"></span>Emergency</span>
      </div>
      <div class="info-row">
        <span class="info-key">Impact Detected</span>
        <span class="info-val red">Yes</span>
      </div>
      <div class="info-row">
        <span class="info-key">LED / Buzzer</span>
        <span class="info-val orange"><span class="dot orange"></span>Active</span>
      </div>
      <div class="info-row">
        <span class="info-key">SMS Sent</span>
        <span class="info-val green">Delivered ✓</span>
      </div>
      <div class="info-row">
        <span class="info-key">Device</span>
        <span class="info-val">Arduino UNO</span>
      </div>
    </div>

    <div class="card">
      <div class="card-title">System</div>
      <div class="info-row">
        <span class="info-key">GPS Module</span>
        <span class="info-val green">Neo-6M Online</span>
      </div>
      <div class="info-row">
        <span class="info-key">GSM Module</span>
        <span class="info-val green">SIM800L Online</span>
      </div>
      <div class="info-row">
        <span class="info-key">Last Update</span>
        <span class="info-val" id="last-update">Just now</span>
      </div>
    </div>

    <div class="card">
      <div class="card-title">Event Log</div>
      <div class="log-item">
        <div class="log-time" id="t1">--:--:--</div>
        <div class="log-msg">⚠ Impact detected by sensor</div>
      </div>
      <div class="log-item">
        <div class="log-time" id="t2">--:--:--</div>
        <div class="log-msg">📍 GPS location acquired</div>
      </div>
      <div class="log-item">
        <div class="log-time" id="t3">--:--:--</div>
        <div class="log-msg">🔔 LED and buzzer activated</div>
      </div>
      <div class="log-item">
        <div class="log-time" id="t4">--:--:--</div>
        <div class="log-msg">✅ SMS sent to emergency contacts</div>
      </div>
      <div class="log-item">
        <div class="log-time" id="t5">--:--:--</div>
        <div class="log-msg">📡 Live tracking started</div>
      </div>
    </div>

  </div>

  <!-- MAP -->
  <div class="map-area">
    <div class="map-bg"></div>

    <!-- Roads -->
    <div class="rd hb" style="top:36%;left:0;right:0;"></div>
    <div class="rd hb" style="top:60%;left:0;right:0;"></div>
    <div class="rd h"  style="top:22%;left:0;right:0;"></div>
    <div class="rd h"  style="top:76%;left:0;right:0;"></div>
    <div class="rd vb" style="left:40%;top:0;bottom:0;"></div>
    <div class="rd vb" style="left:65%;top:0;bottom:0;"></div>
    <div class="rd v"  style="left:22%;top:0;bottom:0;"></div>
    <div class="rd v"  style="left:80%;top:0;bottom:0;"></div>
    <div class="rd h"  style="top:48%;left:40%;width:26%;transform:rotate(-5deg);transform-origin:left center;"></div>

    <!-- Blocks -->
    <div class="blk" style="top:26%;left:25%;width:13%;height:9%;"></div>
    <div class="blk" style="top:26%;left:44%;width:18%;height:9%;"></div>
    <div class="blk" style="top:41%;left:25%;width:13%;height:17%;"></div>
    <div class="blk" style="top:41%;left:69%;width:9%;height:17%;"></div>
    <div class="blk" style="top:65%;left:25%;width:13%;height:9%;"></div>
    <div class="blk" style="top:65%;left:44%;width:18%;height:9%;"></div>
    <div class="blk" style="top:12%;left:69%;width:11%;height:22%;"></div>
    <div class="blk" style="top:80%;left:69%;width:11%;height:8%;"></div>

    <div class="acc-ring"></div>

    <div class="marker">
      <div class="pin-body"><div class="pin-icon">🚗</div></div>
      <div class="pin-label">Accident Location</div>
    </div>

    <!-- Coords box -->
    <div class="map-info-box" style="top:12px;left:12px;">
      <div class="lbl">Coordinates</div>
      <div class="val" id="map-coords">17.390000°N, 78.320000°E</div>
    </div>

    <div class="zoom">
      <div class="zoom-btn">+</div>
      <div class="zoom-divider"></div>
      <div class="zoom-btn">−</div>
    </div>

    <div class="scale">
      <div class="scale-line"></div>
      <div class="scale-text">100 m</div>
    </div>

    <div class="updated-box" id="map-updated">Updated just now</div>
    <div class="attribution">GPS Neo-6M · SIM800L</div>
  </div>

</div>

<script>
  function pad(n){ return String(n).padStart(2,'0'); }

  function tick(){
    const n = new Date();
    document.getElementById('clock').textContent =
      `${pad(n.getHours())}:${pad(n.getMinutes())}:${pad(n.getSeconds())}`;
  }
  setInterval(tick, 1000); tick();

  const accidentAt = new Date();

  function fmt(d){ return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`; }

  const t = accidentAt.getTime();
  document.getElementById('t1').textContent = fmt(new Date(t));
  document.getElementById('t2').textContent = fmt(new Date(t + 1100));
  document.getElementById('t3').textContent = fmt(new Date(t + 1500));
  document.getElementById('t4').textContent = fmt(new Date(t + 9000));
  document.getElementById('t5').textContent = fmt(new Date(t + 10200));

  function updateTimeAgo(){
    const s = Math.floor((Date.now() - accidentAt.getTime()) / 1000);
    const m = Math.floor(s / 60);
    document.getElementById('time-ago').textContent =
      m > 0 ? `${m} min ${s % 60} sec ago` : `${s} sec ago`;
  }
  setInterval(updateTimeAgo, 1000); updateTimeAgo();

  const BLat = 17.3900, BLon = 78.3200;

  function updateGPS(){
    const lat = BLat + (Math.random() - 0.5) * 0.00003;
    const lon = BLon + (Math.random() - 0.5) * 0.00003;
    const acc = (4.6 + Math.random() * 1.2).toFixed(1);
    const sats = 8 + Math.floor(Math.random() * 3);
    const now = new Date();

    document.getElementById('lat').textContent = lat.toFixed(4) + '°N';
    document.getElementById('lon').textContent = lon.toFixed(4) + '°E';
    document.getElementById('acc').textContent = `±${acc} m`;
    document.getElementById('sats').textContent = `${sats} connected`;
    document.getElementById('map-coords').textContent =
      `${lat.toFixed(6)}°N, ${lon.toFixed(6)}°E`;
    document.getElementById('last-update').textContent = fmt(now);
    document.getElementById('map-updated').textContent = `Updated ${fmt(now)}`;
  }
  setInterval(updateGPS, 3000);
</script>
</body>
</html>
